---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site, services, waLink } from "../config/site";

const pageTitle = "Our Services | GB GROUP â€” Jharkhand & West Bengal";
const pageDescription =
  "Explore the four services of GB GROUP: Transport & Export, Education & Placement, Land Sales & Joint Ventures, and Advertisement & Marketing.";

const detail = [
  {
    path: "/services/transport-export",
    bullets: ["Industrial freight & bulk cargo", "Kolkata and Haldia port coordination", "Documentation and customs support"],
  },
  {
    path: "/services/education-placement",
    bullets: ["Course and college guidance", "Admission and scholarship support", "Career counselling and placement"],
  },
  {
    path: "/services/land-joint-work",
    bullets: ["Clear-title plot sales", "Joint venture structuring", "Title, zoning and boundary checks"],
  },
  {
    path: "/services/advertising-marketing",
    bullets: ["Outdoor and print advertising", "Digital and social campaigns", "Brand identity and ground activation"],
  },
];
---

<BaseLayout title={pageTitle} description={pageDescription} canonicalPath="/services">
  <section class="editorial-hero">
    <div class="container">
      <div>
        <span class="eyebrow">What we do</span>
        <h1>Four specialist services. One name you can hold accountable.</h1>
        <p class="hero-sub">
          Different problems, one way of working: understand the requirement, put the right people
          on it, document the details and stay reachable throughout.
        </p>
        <div class="hero-actions">
          <a href="#overview" class="btn btn-primary btn-lg">Explore the services</a>
          <a href={waLink()} target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp btn-lg" data-track="whatsapp" data-track-label="Services hero WhatsApp">Ask a question</a>
        </div>
      </div>
      <div class="editorial-media" aria-hidden="true">
        <img src="/images/hero-transport.webp" alt="" width="1800" height="950" fetchpriority="high" />
      </div>
    </div>
  </section>

  <section class="section" id="overview">
    <div class="container">
      <div class="feature-row" style="margin-bottom:clamp(3rem,6vw,5rem)" data-reveal>
        <div class="feature-media">
          <div class="image-grid">
            <figure class="image-card large"><img src="/images/transport-warehouse.webp" alt="Warehouse and freight operations" loading="lazy" decoding="async" width="1000" height="700" /><figcaption>Freight &amp; warehousing</figcaption></figure>
            <figure class="image-card large"><img src="/images/education-library.webp" alt="Students in a library" loading="lazy" decoding="async" width="1000" height="700" /><figcaption>Campus &amp; careers</figcaption></figure>
          </div>
        </div>
        <div class="feature-copy">
          <span class="eyebrow">The GB GROUP model</span>
          <h2>Specialist work, shared standards.</h2>
          <p class="lead">
            Our four verticals serve very different clients, but they run on the same principles:
            verified information, transparent terms and a named person you can reach.
          </p>
          <ul class="check-list">
            <li>One team for multiple business needs</li>
            <li>Regional coverage across Jharkhand and West Bengal</li>
            <li>Direct escalation to leadership</li>
          </ul>
        </div>
      </div>

      {
        services.map((service, index) => {
          const bullets = detail.find((item) => item.path === service.path)?.bullets || [];
          return (
            <article class="feature-row" style={`--accent:${service.accent}`} data-reveal>
              <div class="feature-media">
                <figure class="media-frame wide">
                  <img src={service.image} alt={service.imageAlt} loading="lazy" decoding="async" width="1000" height="700" />
                </figure>
              </div>
              <div class="feature-copy">
                <span class="eyebrow">0{index + 1} Â· {service.kicker}</span>
                <h2>{service.title}</h2>
                <p class="lead">{service.summary}</p>
                <ul class="check-list">
                  {bullets.map((bullet) => <li>{bullet}</li>)}
                </ul>
                <div class="hero-actions">
                  <a href={service.path} class="btn btn-primary">View service <span class="arrow" aria-hidden="true">â†’</span></a>
                </div>
              </div>
            </article>
          );
        })
      }
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cta-band" data-reveal>
        <div>
          <span class="eyebrow">Not sure where to start?</span>
          <h2>Describe the problem. We'll find the service.</h2>
          <p>Send one message to {site.brand} and we will route it to the right team.</p>
        </div>
        <div class="cta-actions">
          <a href={waLink()} target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp btn-lg" data-track="whatsapp" data-track-label="Services CTA WhatsApp">Chat on WhatsApp</a>
          <a href="/contact" class="btn btn-outline btn-lg">Contact us</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
