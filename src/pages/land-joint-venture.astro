---
import BaseLayout from "../layouts/BaseLayout.astro";
import EnquiryForm from "../components/EnquiryForm.astro";
import { listings, waLink } from "../config/site";
import { collectionSchema } from "../lib/schema";

const pageTitle = "Land & Joint Venture Listings | GB GROUP â€” Jharkhand & West Bengal";
const pageDescription =
  "Browse verified land sales and joint venture opportunities across Jharkhand and West Bengal by location, size and purpose, with direct WhatsApp enquiries.";

const states = ["Jharkhand", "West Bengal"];
const categories = ["Commercial", "Industrial", "Logistics", "Hospitality"];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath="/land-joint-venture"
  accent="land"
  schema={collectionSchema({
    name: "GB GROUP land and joint venture portfolio",
    description: pageDescription,
    path: "/land-joint-venture",
    items: listings.map((item) => ({ id: item.id, name: item.area })),
  })}
>
  <section class="page-hero">
    <img class="hero-bg" src="/images/hero-land.webp" alt="" width="1800" height="950" fetchpriority="high" />
    <div class="container">
      <span class="eyebrow">Portfolio Â· Jharkhand &amp; West Bengal</span>
      <h1>Land with a purpose. Partners with a plan.</h1>
      <p class="hero-sub">
        Seven verified opportunities, each shown with its location, size and intended use. Every
        enquiry goes directly to the person who can discuss terms.
      </p>
      <div class="hero-actions">
        <a href="#portfolio" class="btn btn-primary btn-lg">Browse listings</a>
        <a href="#jv-form" class="btn btn-whatsapp btn-lg">List your land</a>
      </div>
    </div>
  </section>

  <section class="section" id="portfolio">
    <div class="container">
      <div class="section--head">
        <span class="eyebrow">Active portfolio</span>
        <h2>Property listings</h2>
        <p class="lead">Images are representative of each land use; exact site photographs and documents are shared on enquiry.</p>
      </div>

      <div class="filter-bar" data-property-filters>
        <div class="filter-group">
          <span>State</span>
          <div class="filter-buttons">
            <button class="filter-btn" type="button" data-filter-group="state" data-filter-value="" aria-pressed="true">All states</button>
            {states.map((state) => <button class="filter-btn" type="button" data-filter-group="state" data-filter-value={state} aria-pressed="false">{state}</button>)}
          </div>
        </div>
        <div class="filter-group">
          <span>Purpose</span>
          <div class="filter-buttons">
            <button class="filter-btn" type="button" data-filter-group="category" data-filter-value="" aria-pressed="true">All purposes</button>
            {categories.map((category) => <button class="filter-btn" type="button" data-filter-group="category" data-filter-value={category} aria-pressed="false">{category}</button>)}
          </div>
        </div>
        <p class="filter-count"><strong data-filter-count>{listings.length}</strong> listings</p>
      </div>

      <div class="property-grid">
        {
          listings.map((item) => (
            <article class="property-card" data-property-card data-state={item.state} data-category={item.category} data-reveal>
              <div class="property-media">
                <img src={item.image} alt={`Representative image of a ${item.purpose.toLowerCase()} opportunity in ${item.location}`} loading="lazy" decoding="async" width="900" height="600" />
                <span class="property-id">{item.id}</span>
              </div>
              <div class="property-body">
                <span class="property-location">{item.location}</span>
                <h3>{item.area}</h3>
                <div class="property-meta">
                  <div><span>Size</span><strong>{item.size}</strong></div>
                  <div><span>Best for</span><strong>{item.purpose}</strong></div>
                </div>
                <p>{item.detail}</p>
                <div class="property-foot">
                  <span class="deal">{item.type}</span>
                  <a
                    class="btn btn-whatsapp btn-sm"
                    href={waLink(`Hello GB GROUP, I would like details of ${item.id} â€” ${item.area}, ${item.size}, for ${item.purpose}.`)}
                    target="_blank"
                    rel="noopener noreferrer"
                    data-track="whatsapp"
                    data-track-label={`Listing ${item.id}`}
                  >
                    Enquire
                  </a>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--tint" id="jv-form">
    <div class="container">
      <EnquiryForm
        id="jvForm"
        title="Own land? Looking for a development partner?"
        intro="Tell us the location, approximate size and whether you want an outright sale or a joint venture."
        eyebrow="For landowners &amp; developers"
        service="Land Sales & Joint Work"
        source="land-listings"
      />
    </div>
  </section>
</BaseLayout>
