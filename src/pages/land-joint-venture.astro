---
import BaseLayout from "../layouts/BaseLayout.astro";
import EnquiryForm from "../components/EnquiryForm.astro";

const pageTitle = "Land Sales & Joint Venture | GB Group";
const pageDescription = "Explore prime verified Land Sales & Joint Venture listings across Jharkhand and West Bengal by GB Group. Location-wise listings categorized by Area, Size, and Purpose.";

// Location-wise listings categorized by Area, Size, Purpose
const listings = [
  {
    id: "JV-01",
    area: "Kolkata - Sector V, Salt Lake (West Bengal)",
    size: "35 Kathas (~0.58 Acres)",
    purpose: "Commercial IT Park / Grade-A Office Building",
    type: "Joint Venture (50:50 Sharing)",
    zone: "West Bengal Commercial",
    features: "Road frontage 120ft, adjacent to IT corridors, power & municipal approvals ready."
  },
  {
    id: "JV-02",
    area: "Ranchi - Ring Road Commercial Zone (Jharkhand)",
    size: "5.5 Acres (Freehold)",
    purpose: "Logistics Hub / Warehousing / Freight Depot",
    type: "Joint Venture / Outright Sale",
    zone: "Jharkhand Logistics",
    features: "Direct 4-lane highway connectivity, boundary demarcated, non-encumbrance certified."
  },
  {
    id: "JV-03",
    area: "Jamshedpur - Adityapur Industrial Corridor (Jharkhand)",
    size: "2.8 Acres",
    purpose: "Heavy Industrial / Fabrication Plant / Auto Ancillary",
    type: "Joint Venture / Direct Sale",
    zone: "Jharkhand Industrial",
    features: "High-tension electricity line nearby, industrial zone approved, ready for fast possession."
  },
  {
    id: "JV-04",
    area: "Durgapur - NH-19 Expressway Hub (West Bengal)",
    size: "4 Acres",
    purpose: "Automobile Showroom / Commercial Mall / Motel",
    type: "Joint Venture",
    zone: "West Bengal Commercial",
    features: "Prime visibility on Golden Quadrilateral, high traffic catchment, level ground."
  },
  {
    id: "JV-05",
    area: "Dhanbad - GT Road Bypass (Jharkhand)",
    size: "3.2 Acres",
    purpose: "Mineral Processing Yard / Commercial Transport Depot",
    type: "Outright Sale / Joint Venture",
    zone: "Jharkhand Commercial",
    features: "Clear ownership titles, wide heavy-vehicle entry, near major industrial clusters."
  },
  {
    id: "JV-06",
    area: "Howrah - National Highway Corridor (West Bengal)",
    size: "80 Kathas (~1.32 Acres)",
    purpose: "FMCG Warehousing / Light Manufacturing Unit",
    type: "Joint Venture",
    zone: "West Bengal Logistics",
    features: "Quick access to Kolkata city center, container accessibility, strong water supply."
  },
  {
    id: "JV-07",
    area: "Siliguri - Eastern Bypass Corridor (West Bengal)",
    size: "3.5 Acres",
    purpose: "Hospitality Resort / Private Educational Institution",
    type: "Joint Venture / Sale",
    zone: "North Bengal Gateway",
    features: "Scenic foothills backdrop, multi-directional connectivity to Sikkim and Northeast."
  }
];
---

<BaseLayout title={pageTitle} description={pageDescription} canonicalPath="/land-joint-venture">
  <div class="container section">
    <div class="section-header">
      <span class="section-subtitle">Portfolio &bull; Jharkhand &amp; West Bengal</span>
      <h1 class="section-title">Land Sales &amp; Joint Venture Listings</h1>
      <p class="section-desc">
        Verified land parcels and joint venture opportunities arranged in a clear location-wise listing format by <strong>Area</strong>, <strong>Size</strong>, and <strong>Purpose</strong>.
      </p>
    </div>

    <!-- Overview Banner -->
    <div class="card jv-overview-card">
      <div class="grid-2">
        <div>
          <span class="badge" style="margin-bottom: 0.5rem;">For Landowners &amp; Developers</span>
          <h2>Transparent Partnerships &amp; Clear-Title Properties</h2>
          <p>
            GB Group acts as the trusted bridge connecting landowners with credible builders, developers, and corporate investors across <strong>Jharkhand</strong> and <strong>West Bengal</strong>. We ensure transparent revenue/space-sharing ratios, airtight legal documentation, and timely project delivery.
          </p>
        </div>
        <div class="jv-highlights">
          <div class="hl-item">
            <strong>Area:</strong> Prime urban and industrial belts.
          </div>
          <div class="hl-item">
            <strong>Size:</strong> From 25 Kathas to 10+ Acres.
          </div>
          <div class="hl-item">
            <strong>Purpose:</strong> Commercial, Logistics, Industrial &amp; Residential.
          </div>
        </div>
      </div>
    </div>

    <!-- LOCATION-WISE TABLE LAYOUT (Area, Size, Purpose) -->
    <div style="margin-top: 3.5rem;">
      <h2 style="font-size: 1.5rem; margin-bottom: 0.5rem; color: var(--color-primary);">
        Location-Wise Land &amp; Joint Venture Master Table
      </h2>
      <p style="color: #64748b; font-size: 0.95rem; margin-bottom: 1.25rem;">
        Click "Enquire via WhatsApp" to instantly discuss any listed property with CEO Mohit Mallar (74397 86518).
      </p>

      <div class="listing-table-container">
        <table class="listing-table">
          <thead>
            <tr>
              <th>Ref ID</th>
              <th>Area / Location</th>
              <th>Size</th>
              <th>Purpose</th>
              <th>Deal Structure</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            {listings.map((item) => (
              <tr>
                <td><span class="badge">{item.id}</span></td>
                <td>
                  <strong>{item.area}</strong>
                  <div style="font-size: 0.8rem; color: #64748b; margin-top: 2px;">{item.features}</div>
                </td>
                <td><strong>{item.size}</strong></td>
                <td>{item.purpose}</td>
                <td><span class="deal-pill">{item.type}</span></td>
                <td>
                  <a
                    href={`https://wa.me/917439786518?text=${encodeURIComponent(`Hello GB Group, I want details regarding Land Listing [${item.id}]: Area: ${item.area}, Size: ${item.size}, Purpose: ${item.purpose}.`)}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn btn-whatsapp btn-sm"
                  >
                    WhatsApp Enquire
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Location-Wise Listing Cards (Mobile-Optimized Cards View) -->
    <div style="margin-top: 3.5rem;">
      <h2 style="font-size: 1.5rem; margin-bottom: 1rem; color: var(--color-primary);">
        Detailed Listing Breakdown
      </h2>

      <div class="grid-2">
        {listings.map((item) => (
          <div class="card listing-card">
            <div class="card-meta">
              <span class="badge">{item.id}</span>
              <span class="deal-pill">{item.type}</span>
            </div>

            <h3 class="card-area">{item.area}</h3>

            <div class="listing-details">
              <div class="detail-row">
                <span class="label">Plot Size:</span>
                <span class="val">{item.size}</span>
              </div>
              <div class="detail-row">
                <span class="label">Best Purpose:</span>
                <span class="val">{item.purpose}</span>
              </div>
              <div class="detail-row">
                <span class="label">Features:</span>
                <span class="val">{item.features}</span>
              </div>
            </div>

            <div class="listing-action-row">
              <a
                href={`https://wa.me/917439786518?text=${encodeURIComponent(`Hello GB Group, I am enquiring about ${item.id} at ${item.area} (${item.size}) for ${item.purpose}.`)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-whatsapp btn-sm"
                style="width: 100%;"
              >
                Enquire via WhatsApp (74397 86518)
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Landowner / Investor Form -->
    <div style="margin-top: 4rem;" id="jv-form">
      <div class="section-header">
        <span class="section-subtitle">Submit Your Land or Requirement</span>
        <h2 class="section-title">List Your Land or Enquire for Joint Venture</h2>
        <p class="section-desc">
          Do you own land in Jharkhand or West Bengal? Or are you a builder seeking a joint development partner? Connect with GB Group.
        </p>
      </div>

      <EnquiryForm
        title="Land Sales & Joint Venture Enquiry"
        subtitle="Specify Area, Size, and Purpose in your message for immediate evaluation"
        preselectedService="Land Sales & Joint Work"
        isFixedService={true}
        formId="landJvPageForm"
      />
    </div>
  </div>
</BaseLayout>

<style>
  .jv-overview-card {
    background: linear-gradient(135deg, #eff6ff 0%, #ffffff 100%);
    border: 1px solid #bfdbfe;
    padding: 2.5rem;
  }

  .jv-overview-card h2 {
    font-size: 1.6rem;
    color: var(--color-primary);
    margin-bottom: 0.75rem;
  }

  .jv-overview-card p {
    color: #475569;
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0;
  }

  .jv-highlights {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    justify-content: center;
  }

  .hl-item {
    background: #ffffff;
    border: 1px solid var(--color-border);
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md);
    font-size: 0.9rem;
    color: #334155;
  }

  .hl-item strong {
    color: var(--color-primary-dark);
  }

  .deal-pill {
    display: inline-block;
    background: #e0f2fe;
    color: #0369a1;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
  }

  /* Listing Cards */
  .listing-card {
    border-top: 4px solid var(--color-primary);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .card-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
  }

  .card-area {
    font-size: 1.2rem;
    color: var(--color-primary-dark);
    margin-bottom: 1rem;
  }

  .listing-details {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
    font-size: 0.9rem;
  }

  .detail-row {
    display: flex;
    flex-direction: column;
  }

  @media (min-width: 480px) {
    .detail-row {
      flex-direction: row;
      justify-content: space-between;
    }
  }

  .detail-row .label {
    color: #64748b;
    font-weight: 600;
    min-width: 110px;
  }

  .detail-row .val {
    color: #1e293b;
    font-weight: 500;
  }

  .listing-action-row {
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
  }
</style>
