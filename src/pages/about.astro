---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site, waLink } from "../config/site";

const pageTitle = "About GB GROUP | Multi-Service Consultancy in Eastern India";
const pageDescription =
  "Meet GB GROUP â€” a Jharkhand and West Bengal consultancy delivering transport, education, land and marketing services with direct leadership involvement.";
---

<BaseLayout title={pageTitle} description={pageDescription} canonicalPath="/about">
  <section class="split-hero container">
    <div class="split-copy">
      <span class="eyebrow">Who we are</span>
      <h1>One group, four disciplines, one standard of work.</h1>
      <p class="lead">
        GB GROUP exists to make complex work simpler for businesses, landowners, students and
        families across eastern India. Instead of coordinating separate brokers and agencies,
        clients come to one team that stays accountable from first conversation to final delivery.
      </p>
      <p>
        Our strength is local: we know the industrial corridors, the admission landscape, the land
        records and the media routes of Jharkhand and West Bengal. That knowledge is backed by
        documentation, clear communication and direct access to our leadership.
      </p>
      <div class="hero-actions">
        <a href="/services" class="btn btn-primary btn-lg">See our services</a>
        <a href="/contact" class="btn btn-ghost btn-lg">Contact GB GROUP</a>
      </div>
    </div>
    <div class="split-media" data-reveal>
      <figure class="media-frame">
        <img src="/images/about-office.webp" alt="Modern office workspace representing the GB GROUP team environment" loading="lazy" decoding="async" width="1400" height="900" />
        <figcaption class="media-badge">Working across eastern India</figcaption>
      </figure>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <div class="section--head">
        <span class="eyebrow">How we work</span>
        <h2>Four commitments behind every service.</h2>
      </div>
      <div class="steps four">
        <div class="step" data-reveal><h3>Direct access</h3><p>You speak with decision-makers, not a chain of intermediaries.</p></div>
        <div class="step" data-reveal><h3>Verified process</h3><p>Titles, documents, institutions and partners are checked before we proceed.</p></div>
        <div class="step" data-reveal><h3>Regional knowledge</h3><p>We work where the work actually happens â€” across two states and their industrial hubs.</p></div>
        <div class="step" data-reveal><h3>Clear terms</h3><p>Scope, timelines and responsibilities are agreed upfront and kept visible.</p></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="feature-row reverse">
        <div class="feature-copy" data-reveal>
          <span class="eyebrow">Leadership</span>
          <h2>Straight answers from the top.</h2>
          <p>
            <strong>{site.ceo}</strong> leads GB GROUP with a focus on responsive communication and
            practical outcomes. Clients reach our leadership directly for quotations, decisions and
            escalation â€” not a ticket queue.
          </p>
          <div class="hero-actions">
            <a href={`tel:${site.phone}`} class="btn btn-primary" data-track="call" data-track-label="About call">Call {site.phoneDisplay}</a>
            <a href={waLink()} target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp" data-track="whatsapp" data-track-label="About WhatsApp">WhatsApp</a>
            <a href={`mailto:${site.email}`} class="btn btn-ghost" data-track="email">Email</a>
          </div>
          <div class="chip-row" style="margin-top:1.8rem">
            <span class="chip">Jharkhand</span>
            <span class="chip">West Bengal</span>
            <span class="chip">Kolkata Â· Sector V</span>
          </div>
        </div>
        <div class="feature-media" data-reveal>
          <figure class="media-frame">
            <img src="/images/about-city.webp" alt="Skyline of Kolkata's Salt Lake Sector V business district" loading="lazy" decoding="async" width="1400" height="900" />
            <figcaption class="media-badge">Our home base Â· Kolkata</figcaption>
          </figure>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cta-band" data-reveal>
        <div>
          <span class="eyebrow">Work with us</span>
          <h2>Let's discuss your requirement.</h2>
          <p>One conversation is enough to find out whether GB GROUP is the right fit for your project.</p>
        </div>
        <div class="cta-actions">
          <a href={waLink()} target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp btn-lg" data-track="whatsapp" data-track-label="About CTA WhatsApp">Chat on WhatsApp</a>
          <a href="/contact" class="btn btn-outline btn-lg">Send an enquiry</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
