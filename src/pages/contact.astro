---
import BaseLayout from "../layouts/BaseLayout.astro";
import EnquiryForm from "../components/EnquiryForm.astro";

const pageTitle = "Contact Us | GB Group";
const pageDescription = "Contact GB Group CEO Mohit Mallar. Call or WhatsApp 74397 86518, email ceo@gbgroup.co.in. Office: GC 50, Block Sector V, Kolkata, West Bengal - 700064.";
---

<BaseLayout title={pageTitle} description={pageDescription} canonicalPath="/contact">
  <div class="container section">
    <div class="section-header">
      <span class="section-subtitle">Get In Touch</span>
      <h1 class="section-title">Contact GB Group</h1>
      <p class="section-desc">
        Connect directly with CEO Mohit Mallar and our consultancy team across Jharkhand &amp; West Bengal.
      </p>
    </div>

    <!-- Official Contact Details & Map Grid -->
    <div class="contact-grid">
      <!-- Contact Cards -->
      <div class="contact-info-col">
        <div class="card contact-main-card">
          <span class="badge" style="margin-bottom: 0.75rem;">Official Headquarters</span>
          <h2>GB Group Agency Office</h2>
          <p class="office-tagline">
            Serving all 4 services across Jharkhand and West Bengal with zero intermediaries.
          </p>

          <div class="contact-points-list">
            <!-- CEO -->
            <div class="cp-item">
              <div class="cp-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                  <circle cx="12" cy="7" r="4"></circle>
                </svg>
              </div>
              <div class="cp-text">
                <span class="cp-label">CEO &amp; Managing Head</span>
                <span class="cp-val"><strong>Mohit Mallar</strong></span>
              </div>
            </div>

            <!-- Mobile / Call -->
            <div class="cp-item">
              <div class="cp-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                </svg>
              </div>
              <div class="cp-text">
                <span class="cp-label">Mobile / Call Support</span>
                <a href="tel:+917439786518" class="cp-link"><strong>74397 86518</strong></a>
              </div>
            </div>

            <!-- WhatsApp -->
            <div class="cp-item">
              <div class="cp-icon" style="background-color: #dcfce7; color: #16a34a;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.42a8.225 8.225 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.196 8.196 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24m4.52 11.66c-.25-.13-1.47-.72-1.7-.81-.23-.08-.39-.13-.56.13-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.13-1.06-.39-2.02-1.24-.75-.67-1.26-1.5-1.4-1.75-.15-.25-.02-.39.11-.51.11-.11.25-.29.38-.44.13-.14.17-.25.25-.42.08-.17.04-.31-.02-.44-.06-.13-.56-1.35-.77-1.85-.2-.49-.41-.42-.56-.43h-.48c-.17 0-.44.06-.67.31-.23.25-.88.86-.88 2.1 0 1.24.9 2.44 1.03 2.61.13.17 1.77 2.7 4.29 3.79.6.26 1.07.41 1.44.53.6.19 1.15.16 1.58.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.15-1.18-.06-.11-.23-.17-.48-.29z"/>
                </svg>
              </div>
              <div class="cp-text">
                <span class="cp-label">Official WhatsApp Chat</span>
                <a href="https://wa.me/917439786518" target="_blank" rel="noopener noreferrer" class="cp-link" style="color: #15803d;">
                  <strong>+91 74397 86518 (Chat Now)</strong>
                </a>
              </div>
            </div>

            <!-- Email -->
            <div class="cp-item">
              <div class="cp-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                  <polyline points="22,6 12,13 2,6"></polyline>
                </svg>
              </div>
              <div class="cp-text">
                <span class="cp-label">Direct CEO Email</span>
                <a href="mailto:ceo@gbgroup.co.in" class="cp-link"><strong>ceo@gbgroup.co.in</strong></a>
              </div>
            </div>

            <!-- Website -->
            <div class="cp-item">
              <div class="cp-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10"></circle>
                  <line x1="2" y1="12" x2="22" y2="12"></line>
                  <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                </svg>
              </div>
              <div class="cp-text">
                <span class="cp-label">Official Domain</span>
                <a href="https://www.gbgroup.in" class="cp-link"><strong>www.gbgroup.in</strong></a>
              </div>
            </div>

            <!-- Address -->
            <div class="cp-item">
              <div class="cp-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
              </div>
              <div class="cp-text">
                <span class="cp-label">Office Address</span>
                <span class="cp-val">GC 50, Block Sector V, Kolkata, West Bengal – 700064</span>
                <span class="cp-sub">Location: Kolkata, West Bengal (Sector V)</span>
              </div>
            </div>
          </div>

          <div class="card-action-bar">
            <a href="tel:+917439786518" class="btn btn-call btn-sm">Direct Call</a>
            <a href="https://wa.me/917439786518" target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp btn-sm">WhatsApp Chat</a>
            <a href="https://maps.google.com/?q=GC+50,+Sector+V,+Kolkata,+West+Bengal+700064" target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-sm">
              Open Google Maps &rarr;
            </a>
          </div>
        </div>
      </div>

      <!-- Google Maps Embed / Location View -->
      <div class="contact-map-col">
        <div class="card map-card">
          <div class="map-header">
            <h3>Office Location: Sector V, Kolkata</h3>
            <p>GC 50, Block Sector V, Kolkata, West Bengal – 700064</p>
          </div>

          <div class="map-embed-wrapper">
            <iframe
              title="GB Group Office Location Map"
              src="https://maps.google.com/maps?q=GC+50,+Block+Sector+V,+Kolkata,+West+Bengal+700064&t=&z=15&ie=UTF8&iwloc=&output=embed"
              width="100%"
              height="340"
              style="border:0;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
            ></iframe>
          </div>

          <div class="map-footer">
            <a
              href="https://maps.google.com/?q=GC+50,+Sector+V,+Kolkata,+West+Bengal+700064"
              target="_blank"
              rel="noopener noreferrer"
              class="map-direct-link"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" y1="14" x2="21" y2="3"></line>
              </svg>
              View Full Map &amp; Driving Directions (Google Maps)
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Enquiry Form Section -->
    <div style="margin-top: 4rem;" id="contact-enquiry-form">
      <div class="section-header">
        <span class="section-subtitle">Send a Message</span>
        <h2 class="section-title">Enquiry &amp; Callback Request</h2>
        <p class="section-desc">
          Fill out the form below. Your message will be sent straight to CEO Mohit Mallar.
        </p>
      </div>

      <EnquiryForm
        title="Contact GB Group Today"
        subtitle="Prompt response guaranteed for all inquiries in Jharkhand & West Bengal"
        formId="contactPageForm"
      />
    </div>
  </div>
</BaseLayout>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 992px) {
    .contact-grid {
      grid-template-columns: 1.15fr 0.85fr;
    }
  }

  .contact-main-card {
    border-top: 4px solid var(--color-primary);
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .contact-main-card h2 {
    color: var(--color-primary);
    font-size: 1.5rem;
    margin-bottom: 0.35rem;
  }

  .office-tagline {
    font-size: 0.95rem;
    color: #475569;
    margin-bottom: 1.5rem;
  }

  .contact-points-list {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
    margin-bottom: 1.75rem;
  }

  .cp-item {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
  }

  .cp-icon {
    width: 42px;
    height: 42px;
    background-color: var(--color-primary-surface);
    color: var(--color-primary);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .cp-text {
    display: flex;
    flex-direction: column;
  }

  .cp-label {
    font-size: 0.75rem;
    color: #64748b;
    text-transform: uppercase;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .cp-val {
    font-size: 1rem;
    color: #1e293b;
  }

  .cp-sub {
    font-size: 0.825rem;
    color: var(--color-accent);
    font-weight: 600;
  }

  .cp-link {
    font-size: 1.05rem;
    color: var(--color-primary);
  }

  .cp-link:hover {
    color: var(--color-accent);
  }

  .card-action-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: auto;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
  }

  /* Map Card */
  .map-card {
    border-top: 4px solid var(--color-accent);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
  }

  .map-header h3 {
    font-size: 1.25rem;
    color: var(--color-primary);
    margin-bottom: 0.25rem;
  }

  .map-header p {
    font-size: 0.875rem;
    color: #64748b;
    margin-bottom: 1rem;
  }

  .map-embed-wrapper {
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--color-border);
    margin-bottom: 1rem;
  }

  .map-footer {
    text-align: center;
  }

  .map-direct-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--color-primary);
  }

  .map-direct-link:hover {
    color: var(--color-accent);
  }
</style>
