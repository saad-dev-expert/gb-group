---
import BaseLayout from "../layouts/BaseLayout.astro";
import EnquiryForm from "../components/EnquiryForm.astro";
import { site, waLink } from "../config/site";

const pageTitle = "Contact GB GROUP | Kolkata, Jharkhand & West Bengal";
const pageDescription =
  "Contact GB GROUP: call or WhatsApp +91 74397 86518, email ceo@gbgroup.co.in, or visit GC 50, Block Sector V, Kolkata 700064.";
---

<BaseLayout title={pageTitle} description={pageDescription} canonicalPath="/contact">
  <section class="split-hero container">
    <div class="split-copy">
      <span class="eyebrow">Get in touch</span>
      <h1>Speak to GB GROUP.</h1>
      <p class="lead">One number, one inbox, one team. Reach us directly for any of the four services.</p>
    </div>
    <div class="split-media" data-reveal>
      <figure class="media-frame wide">
        <img src="/images/about-city.webp" alt="Kolkata's Salt Lake Sector V business district" loading="lazy" decoding="async" width="1400" height="900" />
        <figcaption class="media-badge">Kolkata Â· West Bengal</figcaption>
      </figure>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container contact-layout">
      <div class="contact-card">
        <span class="eyebrow">Direct channels</span>
        <h2>Reach our team</h2>
        <ul class="contact-lines">
          <li><span>Leadership</span><strong>{site.ceo} â€” CEO, {site.brand}</strong></li>
          <li>
            <span>Call / WhatsApp</span>
            <a href={`tel:${site.phone}`} data-track="call" data-track-label="Contact page call">{site.phoneDisplay}</a>
          </li>
          <li>
            <span>WhatsApp chat</span>
            <a href={waLink()} target="_blank" rel="noopener noreferrer" data-track="whatsapp" data-track-label="Contact page WhatsApp">+91 {site.phoneDisplay}</a>
          </li>
          <li><span>Email</span><a href={`mailto:${site.email}`} data-track="email">{site.email}</a></li>
          <li><span>Office</span><strong>{site.address.full}</strong></li>
          <li><span>Serving</span><strong>Jharkhand &amp; West Bengal</strong></li>
        </ul>
        <div class="hero-actions">
          <a href={`tel:${site.phone}`} class="btn btn-primary" data-track="call" data-track-label="Contact direct call">Call now</a>
          <a href={waLink()} target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp" data-track="whatsapp" data-track-label="Contact WhatsApp chat">WhatsApp</a>
        </div>
      </div>

      <div class="map-frame">
        <iframe
          title="Map showing GB GROUP office in Sector V, Kolkata"
          src="https://maps.google.com/maps?q=GC+50,+Block+Sector+V,+Kolkata,+West+Bengal+700064&t=&z=15&ie=UTF8&iwloc=&output=embed"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
        <a
          class="map-link"
          href="https://maps.google.com/?q=GC+50,+Sector+V,+Kolkata,+West+Bengal+700064"
          target="_blank"
          rel="noopener noreferrer"
          data-track="map"
          data-track-label="Contact directions"
        >
          Open in Google Maps for directions <span aria-hidden="true">â†—</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <EnquiryForm
        id="contactForm"
        title="Send an enquiry"
        intro="Fill in the details once. We use them only to respond to your enquiry."
        eyebrow="Enquiry &amp; callback"
        source="contact"
      />
    </div>
  </section>
</BaseLayout>
