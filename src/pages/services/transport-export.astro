---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import EnquiryForm from "../../components/EnquiryForm.astro";
import FAQ from "../../components/FAQ.astro";
import { faqs, waLink } from "../../config/site";
import { serviceSchema, faqSchema } from "../../lib/schema";

const pageTitle = "Transport & Export in Jharkhand & West Bengal | GB GROUP";
const pageDescription =
  "GB GROUP moves industrial freight across Jharkhand and West Bengal and coordinates exports through Kolkata and Haldia ports, with documentation and on-time delivery support.";
const crumbs = [
  { label: "Home", href: "/" },
  { label: "Services", href: "/services" },
  { label: "Transport & Export" },
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath="/services/transport-export"
  accent="transport"
  breadcrumbs={crumbs}
  schema={[
    serviceSchema({
      name: "Transport & Export",
      description: pageDescription,
      path: "/services/transport-export",
      image: "/images/hero-transport.webp",
    }),
    faqSchema(faqs.transport),
  ]}
>
  <section class="page-hero">
    <img class="hero-bg" src="/images/hero-transport.webp" alt="" width="1800" height="950" fetchpriority="high" />
    <div class="container">
      <span class="eyebrow">01 Â· Logistics &amp; trade</span>
      <h1>Freight that moves. Documents that clear.</h1>
      <p class="hero-sub">
        GB GROUP connects mines, factories and warehouses in Jharkhand with markets, rail heads and
        the ports of Kolkata and Haldia â€” with transit support from pickup to handover.
      </p>
      <div class="hero-actions">
        <a href="#transport-enquiry" class="btn btn-whatsapp btn-lg">Get a freight quote</a>
        <a href={waLink()} target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-lg" data-track="whatsapp" data-track-label="Transport hero WhatsApp">Talk to us now</a>
      </div>
    </div>
  </section>

  <div class="container"><Breadcrumbs items={crumbs} /></div>

  <section class="section">
    <div class="container">
      <div class="section--head">
        <span class="eyebrow">Capability, in pictures</span>
        <h2>Built for cargo that cannot wait.</h2>
      </div>
      <div class="image-grid three">
        <figure class="image-card" data-reveal><img src="/images/transport-fleet.webp" alt="Commercial freight truck ready for movement" loading="lazy" decoding="async" width="1000" height="700" /><figcaption>Verified fleets &amp; heavy cargo</figcaption></figure>
        <figure class="image-card" data-reveal><img src="/images/transport-warehouse.webp" alt="Warehouse with stacked goods and material handling equipment" loading="lazy" decoding="async" width="1000" height="700" /><figcaption>Warehouse &amp; dispatch handling</figcaption></figure>
        <figure class="image-card" data-reveal><img src="/images/hero-logistics.webp" alt="Container ship at a port with cranes" loading="lazy" decoding="async" width="1920" height="1000" /><figcaption>Port &amp; export coordination</figcaption></figure>
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <div class="feature-row reverse">
        <div class="feature-copy" data-reveal>
          <span class="eyebrow">What we move</span>
          <h2>From steel and minerals to containerised freight.</h2>
          <ul class="check-list">
            <li>Industrial and steel cargo â€” bars, structures, machinery</li>
            <li>Minerals, cement, coal by-products and building material</li>
            <li>FMCG, retail merchandise and packaged goods</li>
            <li>20 ft and 40 ft containers for transit and export</li>
            <li>Agricultural and perishable commodities</li>
          </ul>
        </div>
        <div class="feature-media" data-reveal>
          <figure class="media-frame"><img src="/images/transport-road.webp" alt="Freight truck on an intercity highway" loading="lazy" decoding="async" width="1000" height="700" /><figcaption class="media-badge">Interstate corridors</figcaption></figure>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section--head">
        <span class="eyebrow">How it works</span>
        <h2>Four steps from enquiry to delivery.</h2>
      </div>
      <div class="steps four">
        <div class="step" data-reveal><h3>Share the load</h3><p>Pickup point, delivery point, cargo type and timeline.</p></div>
        <div class="step" data-reveal><h3>Plan &amp; price</h3><p>We confirm the right vehicle, route and a clear quote.</p></div>
        <div class="step" data-reveal><h3>Pickup &amp; transit</h3><p>Loading supervision and regular movement updates.</p></div>
        <div class="step" data-reveal><h3>Port or doorstep</h3><p>Delivery, container yard handover or export documentation support.</p></div>
      </div>
      <div style="margin-top:2.5rem" class="chip-row">
        <span class="chip">Ranchi</span><span class="chip">Jamshedpur</span><span class="chip">Dhanbad</span><span class="chip">Bokaro</span><span class="chip">Kolkata</span><span class="chip">Howrah</span><span class="chip">Haldia</span><span class="chip">Durgapur</span><span class="chip">Siliguri</span>
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <div class="feature-row">
        <div class="feature-copy" data-reveal>
          <span class="eyebrow">Export support</span>
          <h2>The paperwork is part of the service.</h2>
          <p class="lead">Invoices, packing lists, shipping bills and e-way bills prepared accurately, with coordination between customs agents, port authorities and container yards.</p>
          <a href={waLink("Hello GB GROUP, I need help with export documentation and port coordination.")} target="_blank" rel="noopener noreferrer" class="btn btn-primary" data-track="whatsapp" data-track-label="Transport export help">Ask about export support</a>
        </div>
        <div class="feature-media" data-reveal>
          <figure class="media-frame wide"><img src="/images/transport-docs.webp" alt="Documents being reviewed at a desk" loading="lazy" decoding="async" width="1000" height="700" /><figcaption class="media-badge">Documentation handled</figcaption></figure>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="transport-enquiry">
    <div class="container">
      <EnquiryForm
        id="transportForm"
        title="Get a transport quote"
        intro="Tell us the pickup point, destination and cargo type. Your enquiry goes straight to our team."
        eyebrow="Transport & Export"
        service="Transport & Export"
        source="transport"
      />
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <div class="section--head"><span class="eyebrow">Good to know</span><h2>Transport &amp; export questions</h2></div>
      <FAQ items={faqs.transport} />
    </div>
  </section>
</BaseLayout>
