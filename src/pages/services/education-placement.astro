---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import EnquiryForm from "../../components/EnquiryForm.astro";
import FAQ from "../../components/FAQ.astro";
import { faqs, waLink } from "../../config/site";
import { serviceSchema, faqSchema } from "../../lib/schema";

const pageTitle = "Education & Placement in Jharkhand & West Bengal | GB GROUP";
const pageDescription =
  "GB GROUP helps students with course selection, college admissions, career counselling and placement support across Jharkhand and West Bengal.";
const crumbs = [
  { label: "Home", href: "/" },
  { label: "Services", href: "/services" },
  { label: "Education & Placement" },
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath="/services/education-placement"
  accent="education"
  breadcrumbs={crumbs}
  schema={[
    serviceSchema({
      name: "Education & Placement",
      description: pageDescription,
      path: "/services/education-placement",
      image: "/images/hero-education.webp",
    }),
    faqSchema(faqs.education),
  ]}
>
  <section class="split-hero container">
    <div class="split-copy">
      <span class="eyebrow">02 Â· Academics &amp; careers</span>
      <h1>The right course. The right campus. The next step.</h1>
      <p class="lead">
        GB GROUP works with students and parents from school to campus to career â€” matching
        interests to courses, opening admission routes in recognised institutions and preparing
        graduates for the workplace.
      </p>
      <div class="hero-actions">
        <a href="#student-enquiry" class="btn btn-primary btn-lg">Ask a counsellor</a>
        <a href="/online-mba-east-india" class="btn btn-outline btn-lg">Online MBA 2027–28</a>
        <a href={waLink()} target="_blank" rel="noopener noreferrer" class="btn btn-ghost btn-lg" data-track="whatsapp" data-track-label="Education hero WhatsApp">Chat on WhatsApp</a>
      </div>
    </div>
    <div class="split-media" data-reveal>
      <figure class="media-frame tall">
        <img src="/images/hero-education.webp" alt="Students together on a university campus" width="1800" height="950" fetchpriority="high" />
        <figcaption class="media-badge">Guidance from campus to career</figcaption>
      </figure>
    </div>
  </section>

  <div class="container"><Breadcrumbs items={crumbs} /></div>

  <section class="section section--tint">
    <div class="container">
      <div class="section--head">
        <span class="eyebrow">Your pathway</span>
        <h2>Four stages, clearly mapped.</h2>
      </div>
      <div class="steps four">
        <div class="step" data-reveal><h3>Understand</h3><p>One-on-one discussion of strengths, interests and budget.</p></div>
        <div class="step" data-reveal><h3>Choose</h3><p>Shortlist courses and recognised institutions that fit.</p></div>
        <div class="step" data-reveal><h3>Admission</h3><p>Forms, documents, entrance guidance and scholarship options.</p></div>
        <div class="step" data-reveal><h3>Career</h3><p>Resume, interviews and referrals to active hiring partners.</p></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section--head">
        <span class="eyebrow">Areas of guidance</span>
        <h2>Support for the questions students actually ask.</h2>
      </div>
      <div class="image-grid">
        <figure class="image-card" data-reveal><img src="/images/education-books.webp" alt="Books and study material" loading="lazy" decoding="async" width="1000" height="700" /><figcaption>Stream &amp; course selection</figcaption></figure>
        <figure class="image-card" data-reveal><img src="/images/education-library.webp" alt="University library" loading="lazy" decoding="async" width="1000" height="700" /><figcaption>College &amp; university admissions</figcaption></figure>
        <figure class="image-card" data-reveal><img src="/images/education-graduation.webp" alt="Graduates celebrating" loading="lazy" decoding="async" width="1000" height="700" /><figcaption>Scholarships &amp; education loans</figcaption></figure>
        <figure class="image-card" data-reveal><img src="/images/education-counselling.webp" alt="A one-to-one guidance conversation" loading="lazy" decoding="async" width="1000" height="700" /><figcaption>Career counselling &amp; placement</figcaption></figure>
      </div>
      <div class="chip-row" style="margin-top:1.8rem">
        <span class="chip">Engineering &amp; Technology</span>
        <span class="chip">Management &amp; Commerce</span>
        <span class="chip">Computer Applications</span>
        <span class="chip">Healthcare &amp; Allied Sciences</span>
        <span class="chip">Law, Design &amp; Humanities</span>
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <div class="feature-row reverse">
        <div class="feature-copy" data-reveal>
          <span class="eyebrow">Admission &amp; placement desk</span>
          <h2>Help with the process, not just the advice.</h2>
          <ul class="check-list">
            <li>Application forms, document checks and eligibility review</li>
            <li>Entrance test and counselling-round guidance</li>
            <li>Education loan and scholarship documentation</li>
            <li>Resume, LinkedIn, mock interviews and group discussions</li>
            <li>Referrals across IT, manufacturing, retail, BFSI and logistics</li>
          </ul>
        </div>
        <div class="feature-media" data-reveal>
          <figure class="media-frame wide"><img src="/images/education-counselling.webp" alt="Counsellor speaking with a student" loading="lazy" decoding="async" width="1000" height="700" /><figcaption class="media-badge">One-to-one guidance</figcaption></figure>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="student-enquiry">
    <div class="container">
      <EnquiryForm
        id="studentForm"
        title="Student enquiry"
        intro="Tell us your qualification and the course or career you are considering. Sharing your requirement takes less than a minute."
        eyebrow="Dedicated student desk"
        service="Education & Placement"
        source="education"
      />
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <div class="section--head"><span class="eyebrow">Good to know</span><h2>Admission &amp; placement questions</h2></div>
      <FAQ items={faqs.education} />
    </div>
  </section>
</BaseLayout>
