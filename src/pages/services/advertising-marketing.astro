---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import EnquiryForm from "../../components/EnquiryForm.astro";
import FAQ from "../../components/FAQ.astro";
import { faqs, waLink } from "../../config/site";
import { serviceSchema, faqSchema } from "../../lib/schema";

const pageTitle = "Advertisement & Marketing in Jharkhand & West Bengal | GB GROUP";
const pageDescription =
  "GB GROUP delivers outdoor hoardings, print, digital campaigns, ground activation and brand identity for businesses across Jharkhand and West Bengal.";
const crumbs = [
  { label: "Home", href: "/" },
  { label: "Services", href: "/services" },
  { label: "Advertisement & Marketing" },
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath="/services/advertising-marketing"
  accent="marketing"
  breadcrumbs={crumbs}
  schema={[
    serviceSchema({
      name: "Advertisement & Marketing",
      description: pageDescription,
      path: "/services/advertising-marketing",
      image: "/images/hero-marketing.webp",
    }),
    faqSchema(faqs.marketing),
  ]}
>
  <section class="editorial-hero">
    <div class="container">
      <div>
        <span class="eyebrow">04 Â· Growth &amp; branding</span>
        <h1>Visibility that turns into enquiries.</h1>
        <p class="hero-sub">
          GB GROUP plans and produces campaigns that work in the real market â€” high-traffic outdoor,
          print that gets seen, digital that reaches the right postcode and teams on the ground.
        </p>
        <div class="hero-actions">
          <a href="#marketing-enquiry" class="btn btn-whatsapp btn-lg">Start a campaign</a>
          <a href="#what-we-do" class="btn btn-outline btn-lg">See examples</a>
        </div>
      </div>
      <div class="editorial-media" aria-hidden="true">
        <img src="/images/hero-marketing.webp" alt="" width="1800" height="950" fetchpriority="high" />
      </div>
    </div>
  </section>

  <div class="container"><Breadcrumbs items={crumbs} /></div>

  <section class="section" id="what-we-do">
    <div class="container">
      <div class="section--head">
        <span class="eyebrow">What we produce</span>
        <h2>From the hoarding to the hashtag.</h2>
      </div>
      <div class="image-grid">
        <figure class="image-card" data-reveal><img src="/images/marketing-billboard.webp" alt="Large outdoor advertising billboard beside a road" loading="lazy" decoding="async" width="1000" height="700" /><figcaption>Outdoor &amp; hoardings</figcaption></figure>
        <figure class="image-card" data-reveal><img src="/images/marketing-print.webp" alt="Posters and printed marketing material" loading="lazy" decoding="async" width="1000" height="700" /><figcaption>Posters, flyers &amp; print</figcaption></figure>
        <figure class="image-card" data-reveal><img src="/images/marketing-digital.webp" alt="Digital campaign design on screens" loading="lazy" decoding="async" width="1000" height="700" /><figcaption>Social &amp; digital campaigns</figcaption></figure>
        <figure class="image-card" data-reveal><img src="/images/marketing-event.webp" alt="Audience at a promotional event" loading="lazy" decoding="async" width="1000" height="700" /><figcaption>Events &amp; ground activation</figcaption></figure>
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <div class="feature-row reverse">
        <div class="feature-copy" data-reveal>
          <span class="eyebrow">Brand identity</span>
          <h2>Look established everywhere customers meet you.</h2>
          <p class="lead">Strategy, logo and style, company profiles, catalogues and signage developed as one consistent identity â€” not disconnected design files.</p>
          <ul class="check-list">
            <li>Positioning and message that fits the regional market</li>
            <li>Brand style, print collateral and catalogues</li>
            <li>Storefront and office signage</li>
          </ul>
        </div>
        <div class="feature-media" data-reveal>
          <figure class="media-frame wide"><img src="/images/marketing-brand.webp" alt="Branding workshop with a whiteboard" loading="lazy" decoding="async" width="1000" height="700" /><figcaption class="media-badge">Brand thinking</figcaption></figure>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section--head">
        <span class="eyebrow">Campaign rhythm</span>
        <h2>Brief, plan, produce, launch.</h2>
      </div>
      <div class="steps four">
        <div class="step" data-reveal><h3>Brief</h3><p>Business goal, audience, target cities and budget.</p></div>
        <div class="step" data-reveal><h3>Plan</h3><p>Channel mix, creative direction and placement plan.</p></div>
        <div class="step" data-reveal><h3>Produce</h3><p>Design, print, digital assets and on-ground material.</p></div>
        <div class="step" data-reveal><h3>Launch &amp; review</h3><p>Execution across locations with enquiries tracked and reviewed.</p></div>
      </div>
      <div style="margin-top:2.4rem" class="chip-row">
        <span class="chip">Retail &amp; showrooms</span>
        <span class="chip">Manufacturing</span>
        <span class="chip">Colleges &amp; institutes</span>
        <span class="chip">Real estate</span>
        <span class="chip">Healthcare</span>
        <span class="chip">Startups &amp; services</span>
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <div class="feature-row">
        <div class="feature-media" data-reveal>
          <figure class="media-frame wide"><img src="/images/marketing-team.webp" alt="Marketing team working together" loading="lazy" decoding="async" width="1000" height="700" /><figcaption class="media-badge">Campaign planning</figcaption></figure>
        </div>
        <div class="feature-copy" data-reveal>
          <span class="eyebrow">Regional execution</span>
          <h2>One team across both states.</h2>
          <p class="lead">Whether the brief is a city-wide outdoor drive or a multi-location admission campaign, we coordinate design, vendors and on-ground teams so the message stays consistent.</p>
          <a href={waLink("Hello GB GROUP, I would like to discuss an advertising campaign in Jharkhand or West Bengal.")} target="_blank" rel="noopener noreferrer" class="btn btn-primary" data-track="whatsapp" data-track-label="Marketing campaign help">Discuss a campaign</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="marketing-enquiry">
    <div class="container">
      <EnquiryForm
        id="marketingForm"
        title="Brief us on your campaign"
        intro="Tell us your business type, target cities and what you want the campaign to achieve."
        eyebrow="Advertisement &amp; marketing"
        service="Advertisement & Marketing"
        source="marketing"
      />
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <div class="section--head"><span class="eyebrow">Good to know</span><h2>Marketing questions</h2></div>
      <FAQ items={faqs.marketing} />
    </div>
  </section>
</BaseLayout>
