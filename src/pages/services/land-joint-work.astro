---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import EnquiryForm from "../../components/EnquiryForm.astro";
import FAQ from "../../components/FAQ.astro";
import { faqs, listings, waLink } from "../../config/site";
import { serviceSchema, faqSchema } from "../../lib/schema";

const pageTitle = "Land Sales & Joint Ventures in Jharkhand & West Bengal | GB GROUP";
const pageDescription =
  "GB GROUP facilitates clear-title land sales and structured joint ventures between landowners and credible developers across Jharkhand and West Bengal.";
const crumbs = [
  { label: "Home", href: "/" },
  { label: "Services", href: "/services" },
  { label: "Land Sales & Joint Work" },
];
const featured = listings.slice(0, 3);
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath="/services/land-joint-work"
  accent="land"
  breadcrumbs={crumbs}
  schema={[
    serviceSchema({
      name: "Land Sales & Joint Work",
      description: pageDescription,
      path: "/services/land-joint-work",
      image: "/images/land-field.webp",
    }),
    faqSchema(faqs.land),
  ]}
>
  <section class="page-hero">
    <img class="hero-bg" src="/images/land-field.webp" alt="" width="1000" height="700" fetchpriority="high" />
    <div class="container">
      <span class="eyebrow">03 Â· Property &amp; partnerships</span>
      <h1>Clear title. Fair terms. Land that gets used.</h1>
      <p class="hero-sub">
        GB GROUP connects landowners with credible developers and buyers across Jharkhand and West
        Bengal â€” with verification, valuation and joint-venture structuring handled before any deal
        moves forward.
      </p>
      <div class="hero-actions">
        <a href="/land-joint-venture" class="btn btn-primary btn-lg">Browse the portfolio</a>
        <a href="#land-enquiry" class="btn btn-whatsapp btn-lg">List your land</a>
      </div>
    </div>
  </section>

  <div class="container"><Breadcrumbs items={crumbs} /></div>

  <section class="section">
    <div class="container">
      <div class="section--head">
        <span class="eyebrow">Two ways we work</span>
        <h2>Buying and selling, or building together.</h2>
      </div>
      <div class="feature-row">
        <div class="feature-media" data-reveal>
          <figure class="media-frame wide"><img src="/images/land-residential.webp" alt="Residential property representing land sales" loading="lazy" decoding="async" width="1000" height="700" /><figcaption class="media-badge">Verified plot sales</figcaption></figure>
        </div>
        <div class="feature-copy" data-reveal>
          <span class="eyebrow">Land sales</span>
          <h2>Know exactly what you are buying.</h2>
          <ul class="check-list">
            <li>30-year deed search and ownership verification</li>
            <li>Encumbrance, mutation and classification checks</li>
            <li>Circle-rate and fair-market valuation guidance</li>
            <li>Boundary demarcation and possession status review</li>
          </ul>
        </div>
      </div>
      <div class="feature-row reverse">
        <div class="feature-copy" data-reveal>
          <span class="eyebrow">Joint ventures</span>
          <h2>Structure the partnership before the project starts.</h2>
          <ul class="check-list">
            <li>Landowners matched with developers with proven track records</li>
            <li>Agreements covering sharing ratio, deposits and timelines</li>
            <li>Commercial, residential, IT and logistics project formats</li>
            <li>Milestone monitoring from sanction to completion</li>
          </ul>
        </div>
        <div class="feature-media" data-reveal>
          <figure class="media-frame wide"><img src="/images/land-industrial.webp" alt="Industrial construction activity" loading="lazy" decoding="async" width="1000" height="700" /><figcaption class="media-badge">Joint development</figcaption></figure>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <div class="section--head">
        <span class="eyebrow">The process</span>
        <h2>From first call to registered handover.</h2>
      </div>
      <div class="steps five">
        <div class="step" data-reveal><h3>Enquire</h3><p>Location, size, purpose and your preferred deal structure.</p></div>
        <div class="step" data-reveal><h3>Verify</h3><p>Title, deed chain, encumbrance and land classification.</p></div>
        <div class="step" data-reveal><h3>Structure</h3><p>Sale, lease or JV ratio with a transparent commercial model.</p></div>
        <div class="step" data-reveal><h3>Agree</h3><p>Documented terms, security and delivery milestones.</p></div>
        <div class="step" data-reveal><h3>Handover</h3><p>Registration support and possession, or project monitoring.</p></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section--head">
        <span class="eyebrow">A look at the portfolio</span>
        <h2>Three opportunities currently on our desk.</h2>
        <p class="lead">Each listing has a dedicated WhatsApp enquiry. The full portfolio is on the <a href="/land-joint-venture">property listings page</a>.</p>
      </div>
      <div class="property-grid">
        {
          featured.map((item) => (
            <article class="property-card" data-reveal>
              <div class="property-media">
                <img src={item.image} alt={`Representative image for ${item.area}`} loading="lazy" decoding="async" width="900" height="600" />
                <span class="property-id">{item.id}</span>
              </div>
              <div class="property-body">
                <span class="property-location">{item.location}</span>
                <h3>{item.area}</h3>
                <div class="property-meta">
                  <div><span>Size</span><strong>{item.size}</strong></div>
                  <div><span>Purpose</span><strong>{item.purpose}</strong></div>
                </div>
                <p>{item.detail}</p>
                <div class="property-foot">
                  <span class="deal">{item.type}</span>
                  <a
                    class="btn btn-whatsapp btn-sm"
                    href={waLink(`Hello GB GROUP, I am interested in ${item.id} â€” ${item.area} (${item.size}).`)}
                    target="_blank"
                    rel="noopener noreferrer"
                    data-track="whatsapp"
                    data-track-label={`Land service ${item.id}`}
                  >
                    Enquire
                  </a>
                </div>
              </div>
            </article>
          ))
        }
      </div>
      <div class="hero-actions" style="margin-top:2rem">
        <a href="/land-joint-venture" class="btn btn-primary">See all 7 listings <span class="arrow" aria-hidden="true">â†’</span></a>
      </div>
    </div>
  </section>

  <section class="section section--tint" id="land-enquiry">
    <div class="container">
      <EnquiryForm
        id="landForm"
        title="List your land or find a partner"
        intro="Include the location, approximate size and whether you are buying, selling or looking for a joint venture."
        eyebrow="Land &amp; joint ventures"
        service="Land Sales & Joint Work"
        source="land"
      />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section--head"><span class="eyebrow">Good to know</span><h2>Land &amp; JV questions</h2></div>
      <FAQ items={faqs.land} />
    </div>
  </section>
</BaseLayout>
