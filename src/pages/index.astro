---
import BaseLayout from "../layouts/BaseLayout.astro";
import ServiceCard from "../components/ServiceCard.astro";
import { site, services, waLink } from "../config/site";

const pageTitle = "GB GROUP | Transport, Education, Land & Marketing in Jharkhand & West Bengal";
const pageDescription =
  "GB GROUP brings Transport & Export, Education & Placement, Land Sales & Joint Ventures, and Advertisement & Marketing together under one roof across Jharkhand and West Bengal.";
---

<BaseLayout title={pageTitle} description={pageDescription} canonicalPath="/">
  <section class="page-hero">
    <img
      class="hero-bg"
      src="/images/hero-logistics.webp"
      alt=""
      width="1920"
      height="1000"
      fetchpriority="high"
    />
    <div class="container">
      <span class="eyebrow">{site.brand} Â· Jharkhand &amp; West Bengal</span>
      <h1>Four essential services. One accountable team.</h1>
      <p class="hero-sub">
        From moving freight to finding the right course, from clear-title land to campaigns that
        convert â€” GB GROUP brings four specialist services together, with direct access to our
        leadership team.
      </p>
      <div class="hero-actions">
        <a href="#services" class="btn btn-primary btn-lg">Explore our services <span class="arrow" aria-hidden="true">â†’</span></a>
        <a
          href={waLink()}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-whatsapp btn-lg"
          data-track="whatsapp"
          data-track-label="Home hero WhatsApp"
        >
          Chat on WhatsApp
        </a>
      </div>

      <div class="stat-band" aria-label="GB GROUP at a glance">
        <div class="stat"><strong>04</strong><span>Core services</span></div>
        <div class="stat"><strong>02</strong><span>States served</span></div>
        <div class="stat"><strong>13+</strong><span>Cities &amp; industrial hubs</span></div>
        <div class="stat"><strong>01</strong><span>Direct point of contact</span></div>
      </div>
    </div>
  </section>

  <section class="section" id="services">
    <div class="container">
      <div class="section--head center" data-reveal>
        <span class="eyebrow">One group. Four capabilities.</span>
        <h2>Built around what eastern India needs.</h2>
        <p class="lead">
          Each service is handled by a focused team, backed by the same network, standards and
          direct oversight. Choose where you need help.
        </p>
      </div>
      <div class="service-grid">
        {services.map((service, index) => <ServiceCard service={service} index={index} />)}
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <div class="feature-row">
        <div class="feature-copy" data-reveal>
          <span class="eyebrow">Regional reach Â· Real presence</span>
          <h2>Local knowledge, without the middlemen.</h2>
          <p class="lead">
            Our work happens on the ground â€” in industrial belts, port corridors, campuses and
            commercial districts across two states. You deal with the people who actually get
            things done.
          </p>
          <ul class="check-list">
            <li>On-ground networks across Jharkhand and West Bengal</li>
            <li>Direct communication with leadership at every step</li>
            <li>Verification and documentation built into every process</li>
          </ul>
          <div class="chip-row" style="margin-top:1.6rem">
            <span class="chip">Ranchi</span>
            <span class="chip">Jamshedpur</span>
            <span class="chip">Dhanbad</span>
            <span class="chip">Kolkata</span>
            <span class="chip">Haldia</span>
            <span class="chip">Durgapur</span>
            <span class="chip">Siliguri</span>
          </div>
        </div>
        <div class="feature-media" data-reveal>
          <figure class="media-frame wide">
            <img src="/images/about-city.webp" alt="Salt Lake Sector V skyline in Kolkata" loading="lazy" decoding="async" width="1400" height="900" />
            <figcaption class="media-badge">Kolkata Â· Sector V</figcaption>
          </figure>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cta-band" data-reveal>
        <div>
          <span class="eyebrow">Start a conversation</span>
          <h2>Talk to {site.brand} directly.</h2>
          <p>Tell us what you are trying to achieve. We will point you to the right service and the right person.</p>
        </div>
        <div class="cta-actions">
          <a
            href={waLink()}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-whatsapp btn-lg"
            data-track="whatsapp"
            data-track-label="Home CTA WhatsApp"
          >
            Chat on WhatsApp
          </a>
          <a href="/contact" class="btn btn-outline btn-lg">Send an enquiry <span class="arrow" aria-hidden="true">â†’</span></a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
