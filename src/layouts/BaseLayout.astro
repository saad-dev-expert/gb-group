---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
}

const {
  title,
  description,
  canonicalPath = "",
} = Astro.props;

const siteUrl = "https://www.gbgroup.in";
const canonicalUrl = canonicalPath ? `${siteUrl}${canonicalPath}` : siteUrl;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#18337a" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="GB Group" />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}/logo.png`} />
    <meta property="og:site_name" content="GB Group" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}/logo.png`} />

    <!-- Structured Data for Business -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ProfessionalService",
      "name": "GB Group",
      "image": "https://www.gbgroup.in/logo.png",
      "url": "https://www.gbgroup.in",
      "telephone": "+917439786518",
      "email": "ceo@gbgroup.co.in",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "GC 50, Block Sector V",
        "addressLocality": "Kolkata",
        "addressRegion": "West Bengal",
        "postalCode": "700064",
        "addressCountry": "IN"
      },
      "areaServed": ["Jharkhand", "West Bengal"],
      "description": "GB Group consultancy and agency offering Transport & Export, Education Consultant & Placement, Land Sales & Joint Work, and Advertisement & Marketing across Jharkhand and West Bengal."
    })} />
  </head>
  <body>
    <!-- Persistent Header across all pages -->
    <Header currentPath={canonicalPath} />

    <!-- Main Page Content -->
    <main id="main-content">
      <slot />
    </main>

    <!-- Persistent Footer across all pages -->
    <Footer />

    <!-- Floating Call & WhatsApp Buttons on every page -->
    <WhatsAppButton />
  </body>
</html>
