---
import { site, services } from "../config/site";
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand-col">
      <a href="/" class="brand brand--footer">
        <img src="/logo.png" alt="" width="42" height="42" class="brand-mark" />
        <span class="brand-wordmark"><strong>{site.brand}</strong></span>
      </a>
      <p>Four essential services. One accountable team across Jharkhand and West Bengal.</p>
      <div class="footer-regions">
        <span>Jharkhand</span><span>West Bengal</span>
      </div>
    </div>

    <div>
      <h2 class="footer-heading">Services</h2>
      <ul class="footer-links">
        {
          services.map((service) => (
            <li>
              <a href={service.path}>{service.title}</a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h2 class="footer-heading">Explore</h2>
      <ul class="footer-links">
        <li><a href="/about">About GB GROUP</a></li>
        <li><a href="/services">All services</a></li>
        <li><a href="/land-joint-venture">Property portfolio</a></li>
        <li><a href="/contact">Contact</a></li>
      </ul>
    </div>

    <div>
      <h2 class="footer-heading">Speak to us</h2>
      <ul class="footer-contact">
        <li><span>CEO</span><strong>{site.ceo}</strong></li>
        <li>
          <span>Call</span>
          <a href={`tel:${site.phone}`} data-track="call" data-track-label="Footer call">{site.phoneDisplay}</a>
        </li>
        <li>
          <span>WhatsApp</span>
          <a
            href={`https://wa.me/${site.whatsappNumber}`}
            target="_blank"
            rel="noopener noreferrer"
            data-track="whatsapp"
            data-track-label="Footer WhatsApp"
          >
            +91 {site.phoneDisplay}
          </a>
        </li>
        <li><span>Email</span><a href={`mailto:${site.email}`} data-track="email">{site.email}</a></li>
      </ul>
    </div>
  </div>

  <div class="container footer-bottom">
    <p>© {year} {site.brand}. All rights reserved.</p>
    <nav aria-label="Legal">
      <a href="/privacy">Privacy Policy</a>
      <a href="/terms">Terms of Use</a>
      <a href="/contact">Office: {site.address.locality}, {site.address.region}</a>
    </nav>
  </div>
</footer>
