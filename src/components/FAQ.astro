---
interface Props {
  items: readonly { q: string; a: string }[];
}
const { items } = Astro.props;
---

<div class="faq-list">
  {
    items.map((item, index) => (
      <details class="faq-item" open={index === 0}>
        <summary>
          <span>{item.q}</span>
          <span class="faq-icon" aria-hidden="true">+</span>
        </summary>
        <p>{item.a}</p>
      </details>
    ))
  }
</div>
