---
import { site, services } from "../config/site";

interface Props {
  id?: string;
  title?: string;
  intro?: string;
  service?: string;
  source?: string;
  eyebrow?: string;
}

const {
  id = "enquiry",
  title = "Tell us what you need",
  intro = "Share a few details and our team will respond directly on WhatsApp or email.",
  service = "",
  source = "website",
  eyebrow = "Enquiry",
} = Astro.props;
---

<section class="enquiry-panel" data-enquiry-panel aria-labelledby={`${id}-title`}>
  <div class="enquiry-intro">
    <span class="eyebrow">{eyebrow}</span>
    <h2 id={`${id}-title`}>{title}</h2>
    <p>{intro}</p>
    <div class="enquiry-direct">
      <span>Prefer to talk now?</span>
      <a href={`tel:${site.phone}`} data-track="call" data-track-label="Enquiry call">{site.phoneDisplay}</a>
      <a
        href={`https://wa.me/${site.whatsappNumber}`}
        target="_blank"
        rel="noopener noreferrer"
        data-track="whatsapp"
        data-track-label="Enquiry WhatsApp"
      >
        WhatsApp
      </a>
    </div>
  </div>

  <div class="enquiry-form-wrap">
    <form
      id={id}
      class="enquiry-form"
      data-enquiry-form
      data-endpoint={site.leadEndpoint}
      data-service={service}
      data-source={source}
      novalidate
    >
      <div class="field-row">
        <div class="field">
          <label for={`${id}-name`}>Full name <span aria-hidden="true">*</span></label>
          <input id={`${id}-name`} name="name" type="text" autocomplete="name" placeholder="Your name" required aria-describedby={`${id}-name-error`} />
          <span class="field-error" data-error-for="name" id={`${id}-name-error`} hidden></span>
        </div>
        <div class="field">
          <label for={`${id}-phone`}>Mobile number <span aria-hidden="true">*</span></label>
          <input id={`${id}-phone`} name="phone" type="tel" inputmode="numeric" autocomplete="tel-national" placeholder="10-digit mobile number" maxlength="15" required aria-describedby={`${id}-phone-error`} />
          <span class="field-error" data-error-for="phone" id={`${id}-phone-error`} hidden></span>
        </div>
      </div>

      <div class="field-row">
        <div class="field">
          <label for={`${id}-email`}>Email <span class="optional">(optional)</span></label>
          <input id={`${id}-email`} name="email" type="email" autocomplete="email" placeholder="you@example.com" aria-describedby={`${id}-email-error`} />
          <span class="field-error" data-error-for="email" id={`${id}-email-error`} hidden></span>
        </div>
        <div class="field">
          <label for={`${id}-service`}>Service</label>
          {
            service ? (
              <input id={`${id}-service`} name="service" type="text" value={service} readonly />
            ) : (
              <select id={`${id}-service`} name="service">
                {services.map((item) => <option value={item.title}>{item.title}</option>)}
              </select>
            )
          }
        </div>
      </div>

      <div class="field">
        <label for={`${id}-message`}>Your requirement <span class="optional">(optional)</span></label>
        <textarea id={`${id}-message`} name="message" rows="3" placeholder="Location, quantity, timeline or anything we should know"></textarea>
      </div>

      <label class="consent">
        <input name="consent" type="checkbox" aria-describedby={`${id}-consent-error`} />
        <span>I agree to be contacted about this enquiry. See the <a href="/privacy" target="_blank" rel="noopener">Privacy Policy</a>.</span>
      </label>
      <span class="field-error" data-error-for="consent" id={`${id}-consent-error`} hidden></span>

      <div class="enquiry-actions">
        <button class="btn btn-whatsapp btn-lg" type="submit">Send enquiry</button>
        <a class="btn btn-ghost btn-lg" data-email-open href={`mailto:${site.email}`} data-track="email" data-track-label="Enquiry email fallback">
          Use email instead
        </a>
      </div>
      <p class="form-note">By submitting, your details are used only to respond to this enquiry.</p>
    </form>

    <div class="form-success" data-form-success hidden>
      <div class="success-icon" aria-hidden="true">✓</div>
      <h3>Enquiry received</h3>
      <p class="form-status" data-form-status role="status" aria-live="polite" hidden></p>
      <a class="btn btn-whatsapp" data-wa-open href={`https://wa.me/${site.whatsappNumber}`} target="_blank" rel="noopener noreferrer">
        Open WhatsApp with your message
      </a>
      <a class="btn btn-ghost" data-email-open href={`mailto:${site.email}`}>Open email instead</a>
      <button class="text-button" type="button" data-form-reset>Edit my details</button>
    </div>
  </div>
</section>
