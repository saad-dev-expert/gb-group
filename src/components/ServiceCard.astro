---
import type { Service } from "../config/site";

interface Props {
  service: Service;
  index?: number;
}
const { service, index } = Astro.props;
---

<a class="service-tile" href={service.path} style={`--tile-accent:${service.accent}`} data-reveal>
  <div class="service-tile-media">
    <img src={service.image} alt={service.imageAlt} loading="lazy" decoding="async" width="1000" height="700" />
    {index !== undefined && <span class="service-tile-index">0{index + 1}</span>}
  </div>
  <div class="service-tile-body">
    <span class="eyebrow">{service.kicker}</span>
    <h3>{service.title}</h3>
    <p>{service.short}</p>
    <span class="tile-link">Explore service <span aria-hidden="true">→</span></span>
  </div>
</a>
