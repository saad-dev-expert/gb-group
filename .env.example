# GB GROUP — optional integration configuration
# Copy to ".env" and fill in values. Never commit real credentials.

# Google Analytics 4 measurement ID (starts with G-). Leave blank to disable analytics.
PUBLIC_GA_ID=

# HTTPS endpoint that accepts a JSON POST of enquiry data.
# e.g. a Cloudflare Worker, Netlify Function, Formspree endpoint, or your CRM webhook.
# Expected JSON body: { name, phone, email, service, message, source, submittedAt }
# Leave blank to use the built-in WhatsApp + email fallback flow.
PUBLIC_LEAD_ENDPOINT=
